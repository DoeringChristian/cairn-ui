#!/usr/bin/env bash
# Auto-rebuild cairn_ui/_dist/ when the committed bundle would otherwise go stale.
# The bundle is checked in because installing must never need Node — so it IS a
# released wheel's payload, and a stale one ships silently.
#
# Two triggers, and BOTH matter:
#   - src/ — the app's own source.
#   - vendor/cairn-plot — the submodule pointer. The bundle compiles the vendored
#     cairn-plot TypeScript in, so a bump changes the output even though no file
#     under src/ was touched. Rebuilding only on the first trigger is how the
#     bundle silently fell a submodule bump behind.
#
# Install (once per clone): git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '^(src/|vendor/cairn-plot($|/))'; then
    echo "UI source or vendored cairn-plot changed — rebuilding bundle..."
    # Captured rather than streamed (a green build is 40 lines of chunk sizes),
    # but a failure is useless without it — print the whole log before bailing.
    build_log=$(npx vite build 2>&1)
    if [ $? -ne 0 ]; then
        echo "ERROR: vite build failed. Fix build errors before committing." >&2
        echo "--- vite output ---" >&2
        printf '%s\n' "$build_log" >&2
        echo "--- end vite output ---" >&2
        exit 1
    fi
    git add cairn_ui/_dist/
    echo "bundle rebuilt and staged."
fi
