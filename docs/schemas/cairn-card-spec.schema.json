{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CardSpecSchema",
  "definitions": {
    "CardSpecSchema": {
      "type": "object",
      "properties": {
        "cardType": {
          "$ref": "#/definitions/CardType"
        },
        "cardSpec": {
          "$ref": "#/definitions/CardSpec"
        },
        "cardsSpec": {
          "$ref": "#/definitions/CardsSpec"
        },
        "reportSpec": {
          "$ref": "#/definitions/ReportSpec"
        },
        "seriesRef": {
          "$ref": "#/definitions/SeriesRef"
        },
        "runSet": {
          "$ref": "#/definitions/RunSetSpec"
        }
      },
      "required": [
        "cardType",
        "cardSpec",
        "cardsSpec",
        "reportSpec",
        "seriesRef",
        "runSet"
      ],
      "additionalProperties": false,
      "description": "Umbrella entry point for schema generation only — `scripts/gen-card-spec-schema.mjs` generates the JSON Schema from THIS type so every card-spec root (`CardsSpec`, `CardSpec`, `ReportSpec`, `CardType`, …) lands under one deterministic `definitions` block with no degenerate wildcard entry. Never constructed at runtime; it exists purely to anchor the generator."
    },
    "CardType": {
      "type": "string",
      "enum": [
        "scalar",
        "image",
        "figure",
        "audio",
        "video",
        "histogram",
        "tensor",
        "text",
        "pointcloud",
        "mesh",
        "boxes3d",
        "volume",
        "preset",
        "custom",
        "parallel",
        "scatter",
        "bar",
        "tile",
        "importance",
        "run-compare",
        "code-diff",
        "scalars",
        "config",
        "table",
        "html",
        "markdown",
        "artifact"
      ]
    },
    "CardSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "#/definitions/CardSettingsSpec"
        },
        "id": {
          "type": "string",
          "description": "Stable uuid. Distinct from the settings storage key — see lib/card-settings.ts."
        },
        "type": {
          "$ref": "#/definitions/CardType",
          "description": "The canonical `CardType` (lib/cards/card-spec.ts) every dispatch site agrees on."
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComparisonSeriesRef"
          }
        }
      },
      "required": [
        "id",
        "series",
        "type"
      ],
      "description": "The schema root for one card entry — `ComparisonCard` (id/type/series) plus the optional inline `settings` blob the ```cairn dialect carries (see `CairnCardInput.settings` in lib/reports/cairn-block.ts)."
    },
    "CardSettingsSpec": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "yScale": {
          "type": "string",
          "enum": [
            "linear",
            "log"
          ]
        },
        "smoothing": {
          "type": "number"
        },
        "smoothingKind": {
          "type": "string",
          "enum": [
            "ema",
            "twema",
            "gaussian",
            "window"
          ]
        },
        "step": {
          "type": "number"
        },
        "x": {
          "type": "string",
          "description": "Scalar cards: the x-axis as an expression over the run (`step`, `wall_time`, `relative_time`, a metric such as `epoch`, `step * 32`)."
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/JSONValue"
          },
          {
            "not": {}
          }
        ]
      },
      "description": "Per-card `settings` (see `CairnCardInput.settings` in lib/reports/cairn-block.ts): a few well-known keys, otherwise any JSON. Each card type's full settings interface lives with the card."
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JSONValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JSONValue"
          }
        }
      ],
      "description": "Any valid JSON value — used to keep per-card `settings` permissive (see `CardSettingsSpec`)."
    },
    "ComparisonSeriesRef": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Metric name."
        }
      },
      "required": [
        "runId",
        "name"
      ],
      "additionalProperties": false
    },
    "CardsSpec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "runSets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RunSetSpec"
          },
          "description": "The cell's run sets; the cards draw the union of their runs."
        },
        "view": {
          "$ref": "#/definitions/RunViewSpec"
        },
        "title": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardSpec"
          }
        }
      },
      "additionalProperties": false,
      "description": "The ```cairn dialect's schema root. Mirrors `CairnSpec` (lib/reports/cairn-block.ts), which remains the actual parser's input type — this is its schema-generation counterpart, kept in sync by hand (both are small and rarely change independently of each other)."
    },
    "RunSetSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "filter": {
          "$ref": "#/definitions/FilterGroupSpec"
        },
        "groupBy": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroupBySpec"
          }
        },
        "latestOnly": {
          "type": "boolean"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SortKeySpec"
          }
        },
        "eyes": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Explicit eyes: `g:<group-by label>:<group>` / `r:<run id>` → shown."
        }
      },
      "additionalProperties": false,
      "description": "A run set (= `RunSet`, lib/run-sets.ts): the workspace's runs table state, frozen; its runs are resolved live. Every field is optional in a fence (defaults: no filter, no grouping, all runs, newest first, no eyes)."
    },
    "FilterGroupSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "group"
        },
        "op": {
          "type": "string",
          "enum": [
            "and",
            "or"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FilterNodeSpec"
          }
        }
      },
      "required": [
        "kind",
        "op",
        "children"
      ],
      "additionalProperties": false,
      "description": "And/or over children; an empty group constrains nothing."
    },
    "FilterNodeSpec": {
      "anyOf": [
        {
          "$ref": "#/definitions/FilterChipSpec"
        },
        {
          "$ref": "#/definitions/FilterExprSpec"
        },
        {
          "$ref": "#/definitions/FilterGroupSpec"
        }
      ]
    },
    "FilterChipSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chip"
        },
        "field": {
          "type": "string",
          "description": "`display_name`, `status`, `tags`, `group`, `job_type`, `values.<key>` or `params.<key>`."
        },
        "op": {
          "$ref": "#/definitions/FilterOperator"
        },
        "arg": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "op",
        "arg"
      ],
      "additionalProperties": false,
      "description": "A builder chip: `field op arg` (`arg` as typed, coerced on evaluation)."
    },
    "FilterOperator": {
      "type": "string",
      "enum": [
        "exact",
        "iexact",
        "gt",
        "gte",
        "lt",
        "lte",
        "in",
        "contains",
        "icontains",
        "startswith",
        "endswith",
        "isnull"
      ],
      "description": "A filter chip's operator (= `Operator`, lib/run-filter.ts)."
    },
    "FilterExprSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "expr"
        },
        "expr": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expr"
      ],
      "additionalProperties": false,
      "description": "A scalar expression a run matches when it is truthy."
    },
    "GroupBySpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "group",
                "job_type",
                "tag"
              ]
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "param"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "expr"
            },
            "expr": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "expr"
          ],
          "additionalProperties": false
        }
      ],
      "description": "One group-by level (= `GroupBy`, lib/runs-table/group.ts)."
    },
    "SortKeySpec": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "description": "`name`, `status`, `created_at`, `duration`, `value:<key>`, `param:<key>`."
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "required": [
        "column",
        "direction"
      ],
      "additionalProperties": false,
      "description": "One sort key (= `SortKey`, lib/runs-table/sort.ts)."
    },
    "RunViewSpec": {
      "type": "object",
      "properties": {
        "hidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Runs hidden from the cell's charts."
        },
        "pinned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Runs drawn first, in this order."
        },
        "baseline": {
          "type": [
            "string",
            "null"
          ],
          "description": "The run the others are compared against."
        }
      },
      "additionalProperties": false,
      "description": "A cell's run view (mirrors `RunView` in lib/run-view.tsx)."
    },
    "ReportSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "additionalProperties": false,
      "description": "A report as published from Python: its markdown `source` plus create-route metadata (see `ReportCreate` in the cairn server's routes/reports.py)."
    },
    "SeriesRef": {
      "$ref": "#/definitions/ComparisonSeriesRef",
      "description": "= `ComparisonSeriesRef` (lib/comparisons/types.ts) — one (run, metric) binding for a card."
    }
  }
}
