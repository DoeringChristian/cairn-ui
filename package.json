{
  "name": "cairn-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:card-schema": "node scripts/gen-card-spec-schema.mjs",
    "check:card-schema": "node scripts/check-card-spec-schema.mjs",
    "gen:plot-schema": "node scripts/gen-plot-spec-schema.mjs",
    "check:plot-schema": "node scripts/check-plot-spec-schema.mjs",
    "build:plot-inline": "vite build --config vite.plot-figure.config.ts && vite build --config vite.plot-core.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/diff": "^7.0.2",
    "@types/react-plotly.js": "^2.6.4",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "html2canvas": "^1.4.1",
    "plotly.js-dist-min": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "three": "^0.185.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
