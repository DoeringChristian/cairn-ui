 },
 {
  "extension": "fancy_lists",
  "name": "parenthesized numbers and #.",
  "markdown": "(1) a\n(2) b\n\n#. c\n#. d",
  "html": "<ol type=\"1\">\n<li>a</li>\n<li>b</li>\n</ol>\n<ol type=\"1\">\n<li>c</li>\n<li>d</li>\n</ol>"
 },
 {
  "extension": "example_lists",
  "name": "numbered across the text, with labelled references",
  "markdown": "(@) First.\n(@second) Second.\n\nText.\n\n(@) Third, after (@second).",
  "html": "<ol type=\"1\">\n<li>First.</li>\n<li>Second.</li>\n</ol>\n<p>Text.</p>\n<ol start=\"3\" type=\"1\">\n<li>Third, after (2).</li>\n</ol>"
 },
 {
  "extension": "citations",
  "name": "bracketed citations",
  "markdown": "As shown [@doe99; @smith2004, p. 33] and [see -@roe].",
  "html": "<p>As shown <span class=\"citation\" data-cites=\"doe99 smith2004\">[@doe99; @smith2004, p. 33]</span> and <span class=\"citation\" data-cites=\"roe\">[see -@roe]</span>.</p>"
 },
 {
  "extension": "citations",
  "name": "e-mail addresses are not citations",
  "markdown": "[mail a@b.c]",
  "html": "<p>[mail <a href=\"mailto:a@b.c\">a@b.c</a>]</p>"
 },
 {
  "extension": "callouts",
  "name": "GitHub callouts still work",
